{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Basic authenticated user profile without sensitive PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "User display name."
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "User avatar URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "photoURL", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document for user email.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google account email."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "email", "updatedAt"]
    },
    "GameProfile": {
      "title": "GameProfile",
      "description": "Saved game configuration profile for Asaw AI.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Game title."
        },
        "platform": {
          "type": "string",
          "enum": ["pc", "mobile", "console", "studio"],
          "description": "Game platform."
        },
        "genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Game genre."
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Player strategy notes for AI."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "name", "platform", "genre", "notes", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session scoped to a user and optional game profile.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Session title."
        },
        "profileId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Associated GameProfile ID or empty string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "title", "profileId", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message within a ChatSession.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent ChatSession document ID."
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "Message sender role."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "description": "Message text content."
        },
        "channel": {
          "type": "string",
          "enum": ["text", "voice", "transcribe", "autocoach"],
          "description": "Origin channel of the message."
        },
        "modelUsed": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Model identifier or empty string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["ownerId", "sessionId", "role", "text", "channel", "modelUsed", "createdAt"]
    },
    "VoiceTranscript": {
      "title": "VoiceTranscript",
      "description": "Recorded microphone voice transcription item.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "profileId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Associated GameProfile ID or empty string."
        },
        "transcriptText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Transcribed Indonesian/game speech text."
        },
        "durationMs": {
          "type": "number",
          "description": "Recording duration in milliseconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["ownerId", "profileId", "transcriptText", "durationMs", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user root document."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only private PII document (email)."
    },
    "/users/{userId}/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/GameProfile" },
      "description": "User-owned saved game profiles."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "User-owned chat sessions."
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a user's chat session."
    },
    "/users/{userId}/transcripts/{transcriptId}": {
      "schema": { "$ref": "#/entities/VoiceTranscript" },
      "description": "User-owned microphone voice transcripts."
    }
  }
}
